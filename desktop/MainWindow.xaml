<Window x:Class="TeleMind.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="TeleMind Hub"
        Width="1260"
        Height="820"
        MinWidth="900"
        MinHeight="600"
        Background="#040805"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <wv2:WebView2 x:Name="WebView" Visibility="Collapsed" />
        <Border x:Name="SplashOverlay" Background="#040805" Padding="32">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="TeleMind Hub"
                           Foreground="#FFFFFF"
                           FontSize="22"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="SplashStatus"
                           Text="Đang khởi chạy engine cục bộ bảo mật..."
                           Foreground="#9CA3AF"
                           FontSize="13"
                           Margin="0,8,0,0"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
