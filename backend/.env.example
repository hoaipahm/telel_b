# TeleMind Personal Hub — Environment Template
# Copy to .env and fill in your values (or configure keys securely inside the Web Dashboard)

# Security: Comma-separated Telegram numeric user IDs allowed to control this bot.
# Leave empty -> FAIL-CLOSED (bot rejects all users until configured!)
ALLOWED_TELEGRAM_USER_IDS=

# Telegram Bot Token from @BotFather (optional here if configured via Web UI)
TELEGRAM_BOT_TOKEN=

# AI Provider API Keys (optional here if configured via Web UI)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Local Admin Token for Web Control Panel API (auto-generated on first boot if left empty)
WEB_ADMIN_TOKEN=

# Optional Master Key for encrypting secrets at rest (auto-generated into data/master.key if omitted)
BOT_MASTER_KEY=

# Network binding (keep 127.0.0.1 for local-only security)
API_HOST=127.0.0.1
API_PORT=8000
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Storage & Limits
DATA_DIR=./data
DAILY_LLM_REQUEST_CAP=200
DAILY_LLM_TOKEN_CAP=500000
TIMEZONE=Asia/Ho_Chi_Minh
